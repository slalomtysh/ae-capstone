{
  "name": "ae-capstone",
  "version": "1.0.0",
  "description": "AE Capstone Project",
  "private": true,
  "engines": {
    "node": "25.6.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "show:versions": "node -v && npm -v",
    "dev:web": "npm run start -w @ae/web",
    "dev:api": "npm run dev -w @ae/api",
    "build:web": "npm run build -w @ae/web",
    "build:api": "npm run build -w @ae/api"
  }
}
